# ProblemForge environment variables
#
# The app runs WITHOUT any of these set: it falls back to a local in-memory
# store seeded with example problems, so you can try the whole flow (post,
# "I have this problem too", replies) with no setup. See SETUP.md to connect
# a real Supabase project.

# Supabase project API settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Where the app is served from (used for links in notification emails, the
# sitemap, robots.txt). After buying the domain, set this to https://problemforge.co
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional: reply email notifications (see SETUP.md > Reply notifications)
# ---------------------------------------------------------------------------

# Supabase service role key (Project Settings -> API -> service_role, "secret").
# SERVER ONLY. Never prefix with NEXT_PUBLIC. It is the only credential that can
# read the private notification tables. Without it, the "notify me" field on the
# post form is hidden and no emails are captured.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend API key (https://resend.com -> API Keys). SERVER ONLY.
# Without both RESEND_API_KEY and EMAIL_FROM, replies are recorded as
# "skipped: not_configured" and no email is ever sent.
RESEND_API_KEY=

# Verified sender identity. Real delivery needs the domain verified in Resend
# (SPF + DKIM DNS records). Format: "ProblemForge <notifications@problemforge.co>"
EMAIL_FROM=

# Optional. Address that replies to a notification email should go to.
EMAIL_REPLY_TO=
